# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build

# Testing
/coverage

# Environment files: never commit secrets. Only the template is tracked.
.env
.env.*
!.env.example

# Local HTTPS certificates (next dev --experimental-https) and keys
/certificates
*.pem
*.key

# Prisma local artifacts (the schema and seed files are tracked)
/prisma/*.db
/prisma/*.db-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Generated by Next.js for AI agents
/AGENTS.md
/CLAUDE.md
